# Example environment file — copy to `.env` and fill in YOUR values.
# NEVER commit a real .env. No passwords or private keys belong in this repo.
# The pipeline reads credentials via the standard mechanisms below.

# --- Google Earth Engine (required for GEDI / Sentinel-1 / Sentinel-2) ---
# Your Google Cloud project with the Earth Engine API enabled:
EE_PROJECT="your-gcp-project-id"

# Interactive auth (recommended for local use):
#   earthengine authenticate        # stores a token in ~/.config/earthengine
#
# Headless/service-account auth (optional, for CI):
#   GOOGLE_APPLICATION_CREDENTIALS="/secure/path/service-account.json"
# Then share nothing here — the earthengine client picks the file up itself.

# --- NASA Earthdata (ONLY needed if you bypass Earth Engine and pull GEDI
# --- HDF5 granules directly from LP DAAC / ORNL DAAC; not used by default) ---
EARTHDATA_USERNAME=""
EARTHDATA_PASSWORD=""
